RewriteEngine On



# ========================
# URL REWRITING RULES
# ========================

# Sitemap
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

# ── ABDM HIP callbacks — single registered bridge URL, ABDM appends these
#    fixed sub-paths (M2 spec v2.8). All route to one receiver; ?k= is kept.
RewriteRule ^api/v3/hip/token/on-generate-token$  telemedicine/api/abdm-webhook.php [L,QSA]
RewriteRule ^api/v3/link/on_carecontext$          telemedicine/api/abdm-webhook.php [L,QSA]
RewriteRule ^api/v3/links/context/on-notify$      telemedicine/api/abdm-webhook.php [L,QSA]
RewriteRule ^api/v3/consent/request/hip/notify$   telemedicine/api/abdm-consent-webhook.php [L,QSA]
RewriteRule ^api/v3/hip/health-information/request$ telemedicine/api/abdm-hi-request-webhook.php [L,QSA]
RewriteRule ^api/v3/hip/patient/share$             telemedicine/api/abdm-scan-share.php [L,QSA]
RewriteRule ^api/v3/hip/patient-share$             telemedicine/api/abdm-scan-share.php [L,QSA]

# ── ABDM HIU callbacks (M3, Consent flow — our system requesting a
#    patient's records from OTHER providers via the consent manager).
RewriteRule ^api/v3/hiu/consent/request/on-init$   telemedicine/api/abdm-hiu-consent-on-init.php [L,QSA]
RewriteRule ^api/v3/hiu/consent/request/notify$    telemedicine/api/abdm-hiu-consent-notify.php [L,QSA]
RewriteRule ^api/v3/hiu/consent/on-fetch$          telemedicine/api/abdm-hiu-consent-on-fetch.php [L,QSA]
RewriteRule ^api/v3/hiu/health-information/on-request$ telemedicine/api/abdm-hiu-health-information-on-request.php [L,QSA]
RewriteRule ^api/v3/hiu/health-information/push$   telemedicine/api/abdm-hiu-health-information-push.php [L,QSA]

# Rewrite Product Details URL
RewriteRule ^department/([^/]+)/?$ e-cardiology.php?alias=$1 [L,QSA]
RewriteRule ^departments/?$ departments.php? [L,QSA]
RewriteRule ^book-appointment/?$ book-appointment.php? [L,QSA]
RewriteRule ^online-clinic/?$ online-clinic.php? [L,QSA]
RewriteRule ^online-services/([^/]+)/?$ book-your-medicine.php?alias=$1 [L,QSA]

#for doctor profile detail page
RewriteRule ^doctor-profile/([^/]+)/?$ doctor-details.php?alias=$1 [L,QSA]

RewriteRule ^printers/([^/]+)/?$ blackprinter.php?alias=$1 [L,QSA]

# Rewrite Products URL
RewriteRule ^products/([^/]+)/?$ products.php?alias=$1 [L,QSA]

RewriteRule ^brand/([^/]+)/?$ brand.php?alias=$1 [L,QSA]

# Rewrite Blog URLs
RewriteRule ^blogs/?$ blog.php? [L,QSA]
RewriteRule ^blogs/([^/]+)/?$ blog-details.php?alias=$1 [L,QSA]

RewriteRule ^doctor-login/?$ doctor-login.php? [L,QSA]
RewriteRule ^doctor-signup/?$ doctor-signup.php? [L,QSA]
RewriteRule ^doctor-network/?$ doctor-network.php? [L,QSA]
RewriteRule ^doctor-plans/?$ doctor-plans.php? [L,QSA]
RewriteRule ^forgot-password/?$ forgot-password.php? [L,QSA]

#for user login and singup
RewriteRule ^user-login/?$ login.php? [L,QSA]
RewriteRule ^user-signup/?$ signup.php? [L,QSA]
RewriteRule ^terms-and-condition/?$ terms-and-condition.php? [L,QSA]
RewriteRule ^contact/?$ contact-us.php? [L,QSA]
RewriteRule ^disclaimer/?$ disclaimer.php? [L,QSA]
RewriteRule ^privacy-policy/?$ privacy-policy.php? [L,QSA]
RewriteRule ^legal-compliance/?$ legal-compliance.php? [L,QSA]

# Enable RewriteBase if needed (Uncomment if required)
# RewriteBase /

# Ensure existing files and directories are accessible
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
# NOTE: disabled for local XAMPP dev — this handler only exists on the cPanel/EasyApache
# production host. On XAMPP, Apache doesn't recognize it and serves .php files as raw
# downloads instead of executing them. Re-enable this block when deploying to cPanel.
# <IfModule mime_module>
#   AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
# </IfModule>
# php -- END cPanel-generated handler, do not edit


# Prevent public access to .env file
<Files ".env">
  Order allow,deny
  Deny from all
</Files>